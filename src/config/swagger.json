{
  "swagger": "2.0",
  "info": {
    "title": "Bookstore REST API Docs",
    "description": "This is a Bookstore API application made with ExpressJS and documented with Swagger",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local server"
    }
  ],
  "tags": [
    {
      "name": "User",
      "description": "User Endpoint"
    },
    {
      "name": "Book",
      "description": "Book Endpoint"
    },
    {
      "name": "Order",
      "description": "Order Endpoint"
    }
  ],
  "paths": {
    "/api/bookstore/auth/signup": {
      "post": {
        "tags": ["User"],
        "consumes": ["application/json"],
        "description": "Sign up method used to create new user.",
        "parameters": [
          {
            "in": "body",
            "name": "signup",
            "description": "Request body as following",
            "required": true,
            "schema": {
              "$ref": "#/definitions/User",
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Authentication Successful"
                },
                "userId": {
                  "type": "number",
                  "example": "5"
                }
              }
            }
          },
          "409": {
            "description": "Username Conflict",
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 409
                },
                "message": {
                  "type": "string",
                  "example": "Authentication failed"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookstore/auth/login": {
      "get": {
        "tags": ["User"],
        "summary": "Login method used to authenticate user",
        "consumes": ["application/json"],
        "parameters": [
          {
            "username": "userEmail",
            "required": true,
            "in": "path",
            "type": "string",
            "description": "Username/Email of the user",
            "password": "userEmail",
            "required": true,
            "type": "string",
            "description": "Password of the user"
          }
        ],
        "responses": {
          "200": {
            "schema": {
              "$ref": "#/definitions/User"
            },
            "description": "A JSON array of user information"
          },
          "400": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 400
                },
                "message": {
                  "type": "string",
                  "example": "Invalid request body"
                }
              }
            },
            "description": "Bad Request"
          },
          "409": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 409
                },
                "message": {
                  "type": "string",
                  "example": "Requested item wasn't found!"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    },

    "/api/bookstore/books": {
      "get": {
        "tags": ["Book"],
        "summary": "Gets all books",
        "consumes": ["application/json"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Book"
            }
          }
        }
      }
    },
    "/api/bookstore/books/{id}": {
      "get": {
        "tags": ["Book"],
        "summary": "Gets single books",
        "consumes": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "type": "number",
            "description": "Book Id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Book"
            }
          }
        }
      }
    },

    "/api/bookstore/orders": {
      "post": {
        "tags": ["Order"],
        "consumes": ["application/json"],
        "description": "Create new book order.",
        "parameters": [
          {
            "in": "body",
            "name": "create new order",
            "description": "Request body as following",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Order",
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Authentication Successful"
                },
                "userId": {
                  "type": "number",
                  "example": "5"
                }
              }
            }
          },
          "409": {
            "description": "Username Conflict",
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 409
                },
                "message": {
                  "type": "string",
                  "example": "Authentication failed"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "example": "Aladdin Stuart"
        },
        "username": {
          "type": "string",
          "example": "dewyn@mailinator.com"
        },
        "password": {
          "type": "string",
          "example": "123456"
        },

        "wallet": {
          "type": "number",
          "example": 100,
          "readOnly": true
        }
      }
    },
    "Book": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "example": 1
        },
        "fullName": {
          "type": "string",
          "example": "Aladdin Stuart"
        },
        "title": {
          "type": "string",
          "example": "Electronics Tutorial"
        },
        "writer": {
          "type": "string",
          "example": "Carlos Harber"
        },

        "cover": {
          "type": "string",
          "example": "https://images-na.ssl-images-amazon.com/images/I/51Ga5GuElyL._AC_SX184_.jpg"
        },
        "price": {
          "type": "number",
          "example": 25
        },
        "tag": {
          "type": "array",
          "example": ["fiction"]
        },
        "description": {
          "type": "string",
          "example": "Corrumpo curto bos paulatim. Quos arcesso centum vulgivagus uter alter. Verto admoneo repellat thymbra vigilo nulla."
        }
      }
    },
    "Order": {
      "type": "object",
      "properties": {
        "user": {
          "type": "number",
          "example": 1
        },
        "book_quantity": {
          "type": "number",
          "example": 2
        },
        "price": {
          "type": "number",
          "example": 25
        },
        "status": {
          "type": "string",
          "example": "PENDING",
          "enum": ["PENDING", "CANCELED", "COMPLETED"],
          "readOnly": true
        }
      }
    }
  }
}
